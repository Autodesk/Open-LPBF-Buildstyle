# ATU session files, written when the project is opened in ATU.
# They hold local state (open tabs, parts, slice results, logs) and
# must not be committed.

# Editor state and build style session settings
*.fsp.user
*.fpbs
*_fpbs.user

# Build style log widget export
*_bs_log_widget.csv

# Build parameter profiles exported by ATU
/Profiles/

