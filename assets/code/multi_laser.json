  {
   "id": "grid",
   "title": "Scanners on a grid",
   "scene": {
    "parts": "plate",
    "spacing": 24,
    "field": 32,
    "strategy": "field_split"
   },
   "notes": [
    "<code>build_scanner_array</code> places the scanners symmetrically around the array centre and numbers them row by row: <code>index = iy * count_x + ix</code>, so laser 1 is at the bottom left. Each scan field is a rectangle centred on its scanner.",
    "The colour of a laser is computed, not a parameter: the hues are spread evenly around the colour wheel, because the number of lasers is itself a parameter."
   ],
   "ranges": [
    {
     "file": "lib/multi_laser/scanner_array.js",
     "start": 125,
     "end": 150,
     "lines": [
      "exports.build_scanner_array = function(a_cfg)",
      "{",
      "  let l_count_x = Math.max(1, Math.round(a_cfg.count_x));",
      "  let l_count_y = Math.max(1, Math.round(a_cfg.count_y));",
      "  let l_count = l_count_x * l_count_y;",
      "  let l_half_w = 0.5 * a_cfg.field_width;",
      "  let l_half_h = 0.5 * a_cfg.field_height;",
      "",
      "  let r_scanners = [];",
      "  for (let iy = 0; iy < l_count_y; ++iy)",
      "  {",
      "    let l_y = a_cfg.center_y + (iy - 0.5 * (l_count_y - 1)) * a_cfg.spacing_y;",
      "    for (let ix = 0; ix < l_count_x; ++ix)",
      "    {",
      "      let l_x = a_cfg.center_x + (ix - 0.5 * (l_count_x - 1)) * a_cfg.spacing_x;",
      "      let l_index = iy * l_count_x + ix;",
      "      r_scanners.push({",
      "        laser_index: l_index,",
      "        center: { x: l_x, y: l_y },",
      "        field: { min_x: l_x - l_half_w, max_x: l_x + l_half_w, min_y: l_y - l_half_h, max_y: l_y + l_half_h },",
      "        color_rgb: generate_laser_color(l_index, l_count)",
      "      });",
      "    }",
      "  }",
      "  return r_scanners;",
      "};"
     ],
     "marks": [
      15,
      19,
      20
     ]
    },
    {
     "file": "lib/multi_laser/scanner_array.js",
     "start": 87,
     "end": 89,
     "lines": [
      "  let l_saturation = 0.70;",
      "  let l_value = 0.95;",
      "  let l_hue = (a_laser_count > 0) ? (360.0 * a_laser_index / a_laser_count) : 0.0;"
     ],
